<dui-fragment>
  <dui-layer width="fill" height="fill">
    <dui-surface width="fill" height="fill" fill="{{props.background}}" border="{{props.accent}}" bevel="1" />
    <dui-if test="{{props.wide}}">
      <dui-heading x="18" y="9" width="276" height="18" label="{{props.title}}" color="{{props.accent}}" />
      <dui-text x="18" y="36" width="276" height="9" label="{{props.subtitle}}" color="{{props.ink}}" />
      <dui-button id="motion" x="306" y="9" width="54" height="18" label="{{props.motion-label}}" action="arcade_motion" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="size" x="366" y="9" width="48" height="18" label="{{props.size-label}}" action="arcade_size" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="help" x="420" y="9" width="42" height="18" label="{{props.help-label}}" action="arcade_help" locked="{{props.busy}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-text x="18" y="216" width="444" height="9" align="center" label="{{props.status}}" color="{{props.ink}}" />
      <dui-text x="18" y="234" width="210" height="9" label="{{props.credits}}" color="{{props.accent}}" />
      <dui-text x="258" y="234" width="204" height="9" align="right" label="{{props.returned}}" color="{{props.ink}}" />
      <dui-button id="less" x="18" y="252" width="36" height="27" label="-" action="arcade_bet" payload="-1" locked="{{props.less-locked}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-text x="60" y="261" width="84" height="9" align="center" label="{{props.wager}}" color="{{props.accent}}" />
      <dui-button id="more" x="150" y="252" width="36" height="27" label="+" action="arcade_bet" payload="1" locked="{{props.more-locked}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="reset" x="198" y="252" width="84" height="27" label="Reset" action="arcade_reset" locked="{{props.busy}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="play" x="294" y="252" width="168" height="27" label="{{props.play-label}}" action="arcade_play" locked="{{props.play-locked}}" fill="{{props.accent}}" color="{{props.background}}" />
    </dui-if>
    <dui-if test="{{props.compact}}">
      <dui-text x="8" y="9" width="156" height="9" label="{{props.title}}" color="{{props.accent}}" />
      <dui-button id="motion" x="172" y="0" width="44" height="18" label="{{props.motion-label}}" action="arcade_motion" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="size" x="220" y="0" width="44" height="18" label="{{props.size-label}}" action="arcade_size" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="help" x="268" y="0" width="44" height="18" label="{{props.help-label}}" action="arcade_help" locked="{{props.busy}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-text x="8" y="126" width="304" height="9" label="{{props.status}}" color="{{props.ink}}" />
      <dui-text x="8" y="144" width="150" height="9" label="{{props.credits}}" color="{{props.accent}}" />
      <dui-text x="172" y="144" width="140" height="9" align="right" label="{{props.returned}}" color="{{props.ink}}" />
      <dui-button id="less" x="8" y="153" width="24" height="18" label="-" action="arcade_bet" payload="-1" locked="{{props.less-locked}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-text x="36" y="162" width="54" height="9" label="{{props.wager}}" color="{{props.accent}}" />
      <dui-button id="more" x="94" y="153" width="24" height="18" label="+" action="arcade_bet" payload="1" locked="{{props.more-locked}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="reset" x="122" y="153" width="54" height="18" label="Reset" action="arcade_reset" locked="{{props.busy}}" fill="{{props.panel}}" color="{{props.ink}}" />
      <dui-button id="play" x="180" y="153" width="132" height="18" label="{{props.play-label}}" action="arcade_play" locked="{{props.play-locked}}" fill="{{props.accent}}" color="{{props.background}}" />
    </dui-if>
  </dui-layer>
</dui-fragment>
